{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "moduleResolution": "node",
    "outDir": "./public/build",
    "rootDir": "./public/engine",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "public/engine/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}